API_INTERNAL_URL=http://localhost:4000/api/v1
API_TIMEOUT_MS=8000

# httpOnly admin session cookie (lib/auth/session.ts). SESSION_COOKIE_SECURE
# must be "true" in any real (HTTPS) deployment — left "false" here since
# local dev and the docker-compose stack are both plain HTTP.
SESSION_COOKIE_NAME=nawy_session
SESSION_COOKIE_SECURE=false
