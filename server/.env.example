NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_GLOBAL_PREFIX=api
API_DEFAULT_VERSION=1
LOG_LEVEL=debug
LOG_PRETTY=true
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=nawy
DB_PASSWORD=nawy_dev_only
DB_NAME=nawy
DB_SSL=false
DB_LOGGING=false
DB_POOL_MAX=10

PUBLIC_UPLOADS_PATH=/uploads

# Dev-only defaults below — the env schema refuses these in production.
JWT_SECRET=dev_only_insecure_secret_change_me_in_production_env_1234567890
JWT_EXPIRES_IN=3600
JWT_ISSUER=nawy-apartments
# BCRYPT_SALT_ROUNDS is unset here on purpose: it defaults to 12, and to 4
# in NODE_ENV=test so registering a user in e2e tests doesn't cost ~300ms.
ADMIN_EMAIL=admin@nawy.local
ADMIN_PASSWORD=ChangeMe_Admin123!
