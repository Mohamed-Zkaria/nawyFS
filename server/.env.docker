# Committed, dev-only values consumed by the `api`/`migrator` services via
# docker-compose.yml's `env_file:`. This is what makes `docker compose up
# --build` work with zero setup on a freshly cloned repo — the env schema
# (env.validation.ts) still refuses these defaults when NODE_ENV=production.
#
# DB_HOST/DB_PORT point at the `db` compose service on the internal Docker
# network — always port 5432 there, regardless of any host port mapping.
# Keep DB_USERNAME/DB_PASSWORD/DB_NAME in sync with the `${DB_USERNAME:-...}`
# etc. defaults docker-compose.yml uses for the `db` service's own
# POSTGRES_* environment — those two are separate mechanisms (compose-file
# variable interpolation vs. container env injection) that don't share a
# source of truth, so a drift between them is a real footgun to watch for.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_GLOBAL_PREFIX=api
API_DEFAULT_VERSION=1
LOG_LEVEL=debug
LOG_PRETTY=true
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

DB_HOST=db
DB_PORT=5432
DB_USERNAME=nawy
DB_PASSWORD=nawy_dev_only
DB_NAME=nawy
DB_SSL=false
DB_LOGGING=false
DB_POOL_MAX=10

PUBLIC_UPLOADS_PATH=/uploads

JWT_SECRET=dev_only_insecure_secret_change_me_in_production_env_1234567890
JWT_EXPIRES_IN=3600
JWT_ISSUER=nawy-apartments
ADMIN_EMAIL=admin@nawy.local
ADMIN_PASSWORD=ChangeMe_Admin123!
